#. source: Orbiting chat-bubble beams type out messages and Lag enemies.
msgid "UPGRADE.weapon_avn.description"
msgstr ""
"Orbitirajuće balona za čavrljanje tipkaju poruke i dodaju Kašnjenje "
"neprijateljima."

#. Upgrade card - name (weapon_cone)
#. source: Very Large Cone
msgid "UPGRADE.weapon_cone.name"
msgstr "Veliki Lomaći Čunj"

#. Upgrade card - description (weapon_cone)
#. source: Orange traffic wedges stuck to you. They cook what they point at with Heat.
msgid "UPGRADE.weapon_cone.description"
msgstr ""
"Narančaste prometne konusi zalijepljeni su za vas. Prže ono na što upiru sa "
"Zagrijavanjem."

#. Upgrade card - name (weapon_blatand)
#. source: Blåtand
msgid "UPGRADE.weapon_blatand.name"
msgstr "Blåtand"

#. Upgrade card - description (weapon_blatand)
#. source: Chains dashed Infect links between enemies at a fixed link length.
msgid "UPGRADE.weapon_blatand.description"
msgstr ""
"Isprekidani lanci Infektiraju veze između neprijatelja na fiksnoj duljini "
