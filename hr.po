#. source: Shoots a giant AVD logo towards the nearest enemy.
msgid "UPGRADE.weapon_avd.description"
msgstr "Ispuca ogromni AVD logo prema najbližem neprijatelju."

#. Upgrade card - name (weapon_bubbles)
#. source: Bubbles
msgid "UPGRADE.weapon_bubbles.name"
msgstr "Mjehurići"

#. Upgrade card - description (weapon_bubbles)
#. source: Giant bubbles float around that add stacks of Infect to enemies.
msgid "UPGRADE.weapon_bubbles.description"
msgstr ""
"Ogrnomni mjehurići lete okolo ekrana i dodaju stekove Infekcije "
"neprijateljima."

#. Upgrade card - name (weapon_cdrive)
#. source: C: Drive
msgid "UPGRADE.weapon_cdrive.name"
msgstr "C: Pogon"

